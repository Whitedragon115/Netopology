# Settings for the full stack (compose.yaml). Copy to .env and fill in every "change-me".
# Backend variables are documented in backend/docs/ENVIRONMENT.md.

# Where people open Netopology. Must match the address in the browser exactly (scheme + host + port).
NETOPOLOGY_PUBLIC_URL=http://localhost
NETOPOLOGY_HTTP_PORT=80
# Secure cookies work on https:// and on http://localhost. Serving plain http on a LAN address
# (e.g. http://192.168.1.10)? Set this to false, or better, put TLS in front.
NETOPOLOGY_COOKIE_SECURE=true

# openssl rand -base64 32
NETOPOLOGY_SECRET_KEY=change-me

# Database passwords (only used inside the Docker network). Set once: changing them later
# requires changing the roles in the database too.
NETOPOLOGY_DB_SUPERUSER_PASSWORD=change-me
NETOPOLOGY_DB_OWNER_PASSWORD=change-me
NETOPOLOGY_DB_APP_PASSWORD=change-me

# Optional: Google / Discord sign-in (both values, or leave empty).
# Redirect URI: $NETOPOLOGY_PUBLIC_URL/api/v1/auth/oauth/google/callback (or /discord/callback)
NETOPOLOGY_GOOGLE_CLIENT_ID=
NETOPOLOGY_GOOGLE_CLIENT_SECRET=
NETOPOLOGY_DISCORD_CLIENT_ID=
NETOPOLOGY_DISCORD_CLIENT_SECRET=
